# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# We do commit Cargo.lock for the binary crate, but not inside library-only crates.
# Revisit once the workspace exists.

# tosumu database artifacts (never commit real databases)
*.tsm
*.tosumu
*.wal
*.pre-v*.bak
*.migrating

# Reviewed, immutable browser-inspection fixtures. These are deliberately
# published with the documentation site; real database artifacts remain ignored.
!docs/overrides/fixtures/
!docs/overrides/fixtures/*.tosumu
!docs/overrides/fixtures/*.tosumu.wal
!docs/overrides/fixtures/*.bin

# Fuzz artifacts
/fuzz/target/
/fuzz/artifacts/
/fuzz/corpus/

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Env / local config
.env
.env.local
.venv/
__pycache__/

# MkDocs build output
/site/

# .NET local packaging / build outputs
/dotnet/.artifacts/
/dotnet/**/bin/
/dotnet/**/obj/


# Local workbench material
/.workbench/

# Exploritory Conversations
/docs/Conversations/
